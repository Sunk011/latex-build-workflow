{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX Workflow: 编译论文（询问 Git 提交）",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.latex-workflow/build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "detail": "Managed by latex-build-workflow"
    },
    {
      "label": "LaTeX Workflow: 直接编译（跳过 Git 提交）",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.latex-workflow/build.ps1",
        "-CommitMode",
        "Skip"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "detail": "Managed by latex-build-workflow"
    },
    {
      "label": "LaTeX Workflow: 清理中间文件（保留 PDF）",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.latex-workflow/build.ps1",
        "-CleanOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Managed by latex-build-workflow"
    }
  ]
}
